# URL gốc của backend NestJS (không có dấu / ở cuối).
# Local:      http://localhost:3001/api
# Production: https://thien-duc-website-backend.onrender.com/api
#
# Lưu ý: khi trỏ vào backend production, phải thêm origin của admin
# (http://localhost:5174 — xem server.port trong vite.config.ts) vào biến
# CORS_ORIGIN của backend trên Render, nếu không trình duyệt sẽ chặn request.
VITE_API_URL=

# URL gốc của website công khai (không có dấu / ở cuối).
# Ảnh dự án lưu trong DB dạng đường dẫn tương đối `/images/projects/...` — đó là
# đường dẫn của website công khai, không phải của admin. Không đặt biến này thì
# ảnh xem trước trong tab "Hình ảnh" sẽ hiện ô giữ chỗ thay vì ảnh thật.
# Local:      http://localhost:3000
# Production: https://thien-duc-website-frontend.vercel.app
VITE_SITE_URL=

# Sentry error tracking (task →5) — DSN của project Sentry riêng cho admin.
# DSN là khóa ingest-only, an toàn nằm trong bundle client (không phải secret).
# Bỏ trống → không init, admin chạy bình thường.
VITE_SENTRY_DSN=

# --- Upload source map lên Sentry (backlog §6) -----------------------------
# CHỈ dùng lúc BUILD, KHÔNG có tiền tố VITE_ nên KHÔNG lọt vào bundle client.
# Đặt ở môi trường build (Vercel/CI), TUYỆT ĐỐI không commit giá trị thật.
#
# Cổng bật: phải có ĐỦ CẢ BA biến dưới đây. Thiếu bất kỳ cái nào → plugin không
# được thêm vào config, không sinh source map, build vẫn xanh và không gọi mạng.
#
# CẢNH BÁO: SENTRY_AUTH_TOKEN là SECRET THẬT (khác DSN). Không bao giờ đặt nó
# vào biến có tiền tố VITE_ và không bao giờ commit.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# (Tùy chọn) Ghi đè định danh release. Bỏ trống thì suy theo thứ tự:
# SENTRY_RELEASE → VERCEL_GIT_COMMIT_SHA → GITHUB_SHA. Không suy được thì bỏ hẳn
# field release (không bịa chuỗi). Release của runtime và của source map đã
# upload LUÔN khớp nhau vì cùng một hàm sinh ra.
SENTRY_RELEASE=
